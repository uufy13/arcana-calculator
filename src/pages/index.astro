---
import BaseLayout from '../layouts/BaseLayout.astro';
import { arcanaCards } from '../data/arcana';

const title = 'Tarot Birth Card Calculator | Arcana Calculator';
const description = 'Calculate your Tarot Birth Card with a clear Major Arcana method. Explore a symbolic reflection based on your birth date, privately in your browser.';
const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const currentYear = new Date().getFullYear();
const years = Array.from({ length: currentYear - 1900 + 1 }, (_, index) => currentYear - index);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Tarot Birth Card Calculator',
  applicationCategory: 'EntertainmentApplication',
  operatingSystem: 'Any',
  url: Astro.url.href,
  description,
};
---
<BaseLayout title={title} description={description} structuredData={structuredData}>
  <section class="site-shell grid gap-10 py-14 sm:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16">
    <div>
      <p class="eyebrow">A private symbolic reflection</p>
      <h1 class="font-display mt-5 max-w-3xl text-5xl leading-[1.02] tracking-tight text-white sm:text-7xl">Tarot Birth Card <span class="text-gold">Calculator</span></h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">Turn your birth date into one of the 22 Major Arcana cards using a simple, transparent numerology method. No accounts, no predictions, and no date leaves your browser.</p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm text-slate-300">
        <span class="rounded-full border border-white/10 px-3 py-1.5">100% browser-based</span>
        <span class="rounded-full border border-white/10 px-3 py-1.5">22 Major Arcana</span>
      </div>
    </div>

    <div class="card-surface p-6 shadow-2xl shadow-black/20 sm:p-8" id="calculator">
      <div class="mb-7">
        <p class="eyebrow">Your date, your reading</p>
        <h2 class="font-display mt-2 text-3xl text-white">Find your Arcana</h2>
        <p class="mt-2 text-sm leading-6 text-slate-400">Enter a date to see the arithmetic step by step.</p>
      </div>
      <form id="arcana-form" novalidate>
        <fieldset>
          <legend class="block text-sm font-medium text-slate-200">Date of birth</legend>
          <div class="mt-2 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <label class="block text-sm text-slate-300" for="birth-month">
              <span class="sr-only">Month</span>
              <select class="mt-1 w-full rounded-xl border border-white/15 bg-ink px-4 py-3 text-white outline-none transition focus:border-gold focus:ring-2 focus:ring-gold/20" id="birth-month" name="birth-month" aria-label="Birth month" required>
                <option value="">Select month</option>
                {monthNames.map((month, index) => <option value={String(index + 1)}>{month}</option>)}
              </select>
            </label>
            <label class="block text-sm text-slate-300" for="birth-day">
              <span class="sr-only">Day</span>
              <select class="mt-1 w-full rounded-xl border border-white/15 bg-ink px-4 py-3 text-white outline-none transition focus:border-gold focus:ring-2 focus:ring-gold/20 disabled:cursor-not-allowed disabled:opacity-60" id="birth-day" name="birth-day" aria-label="Birth day" disabled required>
                <option value="">Select day</option>
              </select>
            </label>
            <label class="block text-sm text-slate-300" for="birth-year">
              <span class="sr-only">Year</span>
              <select class="mt-1 w-full rounded-xl border border-white/15 bg-ink px-4 py-3 text-white outline-none transition focus:border-gold focus:ring-2 focus:ring-gold/20" id="birth-year" name="birth-year" aria-label="Birth year" required>
                <option value="">Select year</option>
                {years.map((year) => <option value={String(year)}>{year}</option>)}
              </select>
            </label>
          </div>
        </fieldset>
        <button class="mt-4 w-full rounded-xl bg-gold px-5 py-3.5 font-semibold text-ink transition hover:bg-amber-300 focus:outline-none focus:ring-2 focus:ring-gold focus:ring-offset-2 focus:ring-offset-ink disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:bg-gold" id="calculate-button" type="submit" disabled>Calculate My Arcana</button>
        <p class="mt-3 text-xs leading-5 text-slate-400">Your date is used only in this browser for the calculation. It is not sent to a server.</p>
        <p class="mt-4 hidden rounded-lg border border-red-300/20 bg-red-400/10 p-3 text-sm text-red-200" id="form-error" role="alert"></p>
      </form>
      <div class="mt-8 hidden border-t border-white/10 pt-8" id="result" aria-live="polite">
        <p class="eyebrow">Your birth card</p>
        <div class="mt-3 flex items-end justify-between gap-4">
          <div><p class="text-sm text-slate-400">Major Arcana</p><p class="font-display text-5xl text-white" id="result-name"></p></div>
          <span class="font-display text-6xl leading-none text-gold" id="result-number"></span>
        </div>
        <p class="mt-5 text-slate-300" id="result-intro"></p>
        <div class="mt-6 rounded-xl bg-ink/70 p-4">
          <h3 class="text-sm font-semibold text-white">Calculation</h3>
          <p class="mt-2 font-mono text-sm leading-7 text-gold" id="calculation-steps"></p>
        </div>
        <a class="mt-5 inline-flex text-sm font-semibold text-gold hover:text-amber-300" id="result-link" href="/">Read the symbolic meaning →</a>
        <div class="mt-7 rounded-xl border border-gold/20 bg-gold/5 p-5">
          <p class="eyebrow">Continue exploring</p>
          <h3 class="font-display mt-2 text-2xl text-white">Go Deeper Into Your Birth Card</h3>
          <p class="mt-2 text-sm leading-6 text-slate-300">Explore what a full Birth Card reading could include.</p>
          <a class="mt-4 inline-flex rounded-lg bg-gold px-4 py-2.5 text-sm font-semibold text-ink transition hover:bg-amber-300" id="full-reading-link" href="/full-reading/">Explore the Full Reading</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-ink-soft/60 py-16" id="method">
    <div class="site-shell grid gap-10 lg:grid-cols-2 lg:items-start">
      <div><p class="eyebrow">The method</p><h2 class="font-display mt-3 text-4xl text-white">Clear enough to check yourself.</h2></div>
      <div class="space-y-5 text-slate-300"><p>We add the numeric month, day, and full four-digit year. If the total is greater than 22, we add its digits and continue until it falls between 1 and 22. The final number maps to a Major Arcana card; 22 is a special alias for The Fool.</p><p>This is one approachable birth-card method, not a universal rule. Tarot traditions and numerology systems may reduce dates differently or work with paired cards. Use this result as a prompt for reflection and entertainment—not as a scientific prediction of the future.</p><a class="inline-flex font-semibold text-gold hover:text-amber-300" href="/how-it-works">Read the full explanation →</a></div>
    </div>
  </section>

  <section class="site-shell py-16" id="arcana-library">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><p class="eyebrow">The library</p><h2 class="font-display mt-3 text-4xl text-white">Explore the 22 Arcana</h2></div><p class="max-w-sm text-sm leading-6 text-slate-400">Browse every card for a short symbolic meaning and a little more context.</p></div>
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {arcanaCards.map((card) => <a class="group rounded-xl border border-white/10 bg-ink-soft/50 p-4 transition hover:-translate-y-0.5 hover:border-gold/50" href={`/arcana/${card.number}`}><span class="text-sm text-gold">{card.number}</span><span class="mt-1 block font-display text-lg text-white group-hover:text-gold">{card.name}</span></a>)}
    </div>
  </section>
</BaseLayout>

<script>
  import { calculateArcana } from '../lib/calculator';
  import { getArcana } from '../data/arcana';
  const form = document.querySelector<HTMLFormElement>('#arcana-form');
  const monthSelect = document.querySelector<HTMLSelectElement>('#birth-month');
  const daySelect = document.querySelector<HTMLSelectElement>('#birth-day');
  const yearSelect = document.querySelector<HTMLSelectElement>('#birth-year');
  const calculateButton = document.querySelector<HTMLButtonElement>('#calculate-button');
  const error = document.querySelector('#form-error');
  const result = document.querySelector('#result');

  function getDaysInMonth(month, year) {
    if (month === 2 && !year) return 28;
    return new Date(year || 2000, month, 0).getDate();
  }

  function updateDayOptions() {
    if (!daySelect) return;
    const month = Number(monthSelect?.value);
    const year = yearSelect?.value ? Number(yearSelect.value) : undefined;
    const selectedDay = daySelect.value;
    daySelect.innerHTML = '<option value="">Select day</option>';
    daySelect.disabled = !month;
    if (!month) return;

    const maximumDay = getDaysInMonth(month, year);
    for (let day = 1; day <= maximumDay; day += 1) {
      const option = document.createElement('option');
      option.value = String(day);
      option.textContent = String(day);
      daySelect.append(option);
    }
    if (selectedDay && Number(selectedDay) <= maximumDay) daySelect.value = selectedDay;
  }

  function updateSubmitState() {
    if (!calculateButton) return;
    calculateButton.disabled = !monthSelect?.value || !daySelect?.value || !yearSelect?.value;
  }

  monthSelect?.addEventListener('change', updateDayOptions);
  monthSelect?.addEventListener('change', updateSubmitState);
  daySelect?.addEventListener('change', updateSubmitState);
  yearSelect?.addEventListener('change', () => {
    if (Number(monthSelect?.value) === 2) updateDayOptions();
    updateSubmitState();
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    error?.classList.add('hidden');
    const month = monthSelect?.value ?? '';
    const day = daySelect?.value ?? '';
    const year = yearSelect?.value ?? '';
    if (!month || !day || !year) {
      if (error) {
        error.textContent = 'Please select your month, day, and year.';
        error.classList.remove('hidden');
      }
      result?.classList.add('hidden');
      updateSubmitState();
      return;
    }
    const dateString = month && day && year
      ? `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`
      : '';
    try {
      const calculation = calculateArcana(dateString);
      const card = getArcana(calculation.cardNumber);
      document.querySelector('#result-number').textContent = String(calculation.arcanaNumber);
      document.querySelector('#result-name').textContent = card.name;
      document.querySelector('#result-intro').textContent = card.description;
      document.querySelector('#calculation-steps').textContent = `${calculation.steps.join('  →  ')}  →  ${calculation.arcanaNumber} · ${card.name}`;
      document.querySelector('#result-link').setAttribute('href', `/arcana/${calculation.cardNumber}`);
      document.querySelector('#full-reading-link').setAttribute('href', `/full-reading/?arcana=${calculation.arcanaNumber}#sample-reading`);
    } catch (caughtError) {
      if (error) {
        error.textContent = caughtError instanceof Error ? caughtError.message : 'Please enter a valid date.';
        error.classList.remove('hidden');
      }
      result?.classList.add('hidden');
      return;
    }
    result?.classList.remove('hidden');
    result?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
</script>
