---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Privacy | Arcana Calculator';
const description = 'Learn how Arcana Calculator handles birth dates: calculations happen locally in your browser and no account or database is used.';
const structuredData = { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: Astro.url.href };
---
<BaseLayout title={title} description={description} structuredData={structuredData}>
  <article class="site-shell max-w-3xl py-14 sm:py-20">
    <p class="eyebrow">Privacy</p>
    <h1 class="font-display mt-4 text-5xl tracking-tight text-white sm:text-6xl">Your date stays with you.</h1>
    <p class="mt-6 text-xl leading-8 text-slate-300">Arcana Calculator is designed to calculate your result without collecting your birth date.</p>
    <section class="mt-12 space-y-5 border-t border-white/10 pt-10 text-lg leading-8 text-slate-300">
      <p><strong class="text-white">No account is required.</strong> You can use the calculator without creating an account.</p>
      <p><strong class="text-white">No email is required.</strong> We do not ask for an email address to calculate an Arcana.</p>
      <p><strong class="text-white">Birth date is used only for calculation.</strong> The date you enter is used only to calculate the result shown in your browser.</p>
      <p><strong class="text-white">Calculation is performed locally in the browser.</strong> The calculator runs its arithmetic on your device.</p>
      <p><strong class="text-white">Birth date is not sent to a server for calculation.</strong> There is no calculation API or backend in this project.</p>
      <p><strong class="text-white">No database is used to store birth dates.</strong> This static site has no database or account system.</p>
    </section>
    <p class="mt-10 text-sm leading-6 text-slate-400">This page describes the calculator’s local calculation design. It does not make claims about unrelated third-party services or browser/network behavior outside the calculator itself.</p>
  </article>
</BaseLayout>
