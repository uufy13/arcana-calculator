---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArcana } from '../data/arcana';

const title = 'Full Tarot Birth Card Reading | Arcana Calculator';
const description = 'Explore a deeper symbolic interpretation of your Tarot Birth Card, including themes, symbolism, strengths, challenges, and reflection prompts.';
const sampleCard = getArcana(8);
const canonical = new URL('/full-reading/', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
};
---
<BaseLayout title={title} description={description} canonical={canonical} structuredData={structuredData}>
  <section class="site-shell max-w-5xl py-14 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
      <div>
        <p class="eyebrow">A deeper symbolic layer</p>
        <h1 class="font-display mt-5 max-w-3xl text-5xl leading-[1.02] tracking-tight text-white sm:text-7xl">Go Deeper Into Your <span class="text-gold">Birth Card</span></h1>
        <p class="mt-6 max-w-2xl text-xl leading-8 text-slate-300">Your free result shows your card. A full reading explores its symbolism, themes, and deeper patterns.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="rounded-xl bg-gold px-5 py-3 font-semibold text-ink transition hover:bg-amber-300" href="#sample-reading">See a Sample Reading</a>
          <a class="rounded-xl border border-white/15 px-5 py-3 font-semibold text-white transition hover:border-gold/50 hover:text-gold" href="#full-reading">Explore the Full Reading</a>
        </div>
      </div>
      <div class="card-surface p-6 sm:p-8">
        <p class="eyebrow">Your free result</p>
        <p class="mt-3 text-sm text-slate-400" id="birth-card-label">Your Birth Card</p>
        <p class="font-display mt-2 text-4xl text-white" id="birth-card-name">Your Birth Card</p>
        <p class="mt-2 text-gold" id="birth-card-number">Explore a deeper interpretation below.</p>
        <p class="mt-5 text-sm leading-6 text-slate-400">This page uses only the Arcana result passed from the calculator. Your birth date is not included in the URL or sent to a server.</p>
      </div>
      <div class="mt-8 text-center"><a class="inline-flex rounded-xl bg-gold px-6 py-3 font-semibold text-ink transition hover:bg-amber-300" href="#interest">Explore the Full Reading</a><p class="mt-3 text-sm text-slate-400">A more detailed version would explore your specific Birth Card in greater depth.</p></div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-ink-soft/60 py-16" id="full-reading">
    <div class="site-shell max-w-5xl">
      <div class="max-w-2xl"><p class="eyebrow">Free result vs. full reading</p><h2 class="font-display mt-3 text-4xl text-white">See what the deeper version could add.</h2><p class="mt-4 leading-7 text-slate-300">The calculator gives you a clear starting point. A longer reading gives each symbol room to connect with the themes and questions that matter to you.</p></div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <div class="rounded-2xl border border-white/10 bg-ink p-6"><p class="eyebrow">Free result</p><ul class="mt-5 space-y-3 text-slate-300"><li>✓ Birth Card</li><li>✓ Arcana number</li><li>✓ Calculation</li><li>✓ Basic symbolic meaning</li></ul></div>
        <div class="rounded-2xl border border-gold/30 bg-gold/5 p-6"><p class="eyebrow">Full reading</p><ul class="mt-5 space-y-3 text-slate-200"><li>✓ Everything in the free result</li><li>✓ Deeper symbolic interpretation</li><li>✓ Core themes</li><li>✓ Strengths and challenges</li><li>✓ Card symbolism</li><li>✓ Reflection prompts</li><li>✓ Personalized interpretation</li><li>✓ A structured reading designed to be saved and revisited</li></ul></div>
      </div>
    </div>
  </section>

  <section class="site-shell max-w-5xl py-16 sm:py-20" id="sample-reading">
    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end"><div><p class="eyebrow">Example preview</p><h2 class="font-display mt-3 text-4xl text-white">Sample Full Reading</h2></div><p class="max-w-sm text-sm leading-6 text-slate-400">This is a sample for <strong class="text-slate-200">{sampleCard.name}</strong>. It is an example, not your personal full report.</p></div>
    <div class="mt-8 overflow-hidden rounded-3xl border border-white/10 bg-ink-soft shadow-2xl shadow-black/20">
      <div class="border-b border-white/10 bg-ink px-6 py-7 sm:px-10"><div class="flex items-start justify-between gap-5"><div><p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">Sample · Example · Preview</p><h3 class="font-display mt-3 text-4xl text-white">{sampleCard.name}</h3><p class="mt-2 text-slate-400">Major Arcana · {sampleCard.number}</p></div><span class="font-display text-6xl leading-none text-gold">{sampleCard.number}</span></div></div>
      <div class="grid gap-px bg-white/10 sm:grid-cols-2">
        <section class="bg-ink-soft p-6 sm:p-8"><h4 class="font-display text-2xl text-white">Core Theme</h4><p class="mt-3 leading-7 text-slate-300">Strength asks what becomes possible when courage is patient, grounded, and compassionate rather than forceful.</p></section>
        <section class="bg-ink-soft p-6 sm:p-8"><h4 class="font-display text-2xl text-white">Symbolism</h4><p class="mt-3 leading-7 text-slate-300">The image of a calm figure beside a lion points toward a relationship with instinct built through trust, presence, and care.</p></section>
        <section class="bg-ink-soft p-6 sm:p-8"><h4 class="font-display text-2xl text-white">Strengths</h4><p class="mt-3 leading-7 text-slate-300">This theme can invite steadiness, emotional courage, resilience, and the ability to meet intensity without becoming consumed by it.</p></section>
        <section class="bg-ink-soft p-6 sm:p-8"><h4 class="font-display text-2xl text-white">Challenges</h4><p class="mt-3 leading-7 text-slate-300">A reflective reading might ask whether patience has become suppression, or whether gentleness is being mistaken for a lack of power.</p></section>
        <section class="bg-ink-soft p-6 sm:p-8 sm:col-span-2"><h4 class="font-display text-2xl text-white">Reflection Prompts</h4><ul class="mt-3 grid gap-3 leading-7 text-slate-300 sm:grid-cols-2"><li>Where could a slower response create more choice?</li><li>What feeling deserves to be met without judgment?</li><li>Which kind of courage is needed in this season?</li><li>What would compassionate self-trust look like today?</li></ul></section>
      </div>
      <div class="border-t border-white/10 px-6 py-5 text-sm text-slate-400 sm:px-10">A full reading would adapt these themes to your specific Birth Card and invite more personal reflection. Tarot is used here as symbolic reflection, not as scientific prediction.</div>
    </div>
  </section>

  <section class="border-t border-white/10 bg-ink-soft/60 py-16" id="interest">
    <div class="site-shell max-w-3xl text-center"><p class="eyebrow">Product research</p><h2 class="font-display mt-3 text-4xl text-white">Interested in a deeper reading?</h2><p class="mx-auto mt-4 max-w-xl leading-7 text-slate-300">The full reading is being prepared. Let us know that this kind of expanded reflection would be useful to you.</p><a class="mt-7 inline-flex rounded-xl bg-gold px-6 py-3 font-semibold text-ink transition hover:bg-amber-300 focus:outline-none focus:ring-2 focus:ring-gold focus:ring-offset-2 focus:ring-offset-ink" href="/full-reading/interest/">I’m Interested</a><p class="mt-5 text-xs text-slate-500">No email, account, birth date, or other personal information is collected.</p></div>
  </section>
</BaseLayout>

<script>
  import { getArcana } from '../data/arcana';

  const params = new URLSearchParams(window.location.search);
  const arcanaParam = Number(params.get('arcana'));
  const hasArcana = Number.isInteger(arcanaParam) && arcanaParam >= 0 && arcanaParam <= 22;
  if (hasArcana) {
    const card = getArcana(arcanaParam);
    document.querySelector('#birth-card-label').textContent = 'Your Birth Card';
    document.querySelector('#birth-card-name').textContent = card.name;
    document.querySelector('#birth-card-number').textContent = `Arcana ${arcanaParam}`;
  }

</script>
